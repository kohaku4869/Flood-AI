# ==========================================
# Flood-AI Environment Variables Example
# ==========================================

# 1. Gemini API Configuration (Agent Service)
# Provide a comma-separated list of Gemini API keys for rotation
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2

# 2. OpenRouteService API Configuration (Routing Service)
# Sign up at https://openrouteservice.org/dev/#/signup to get your free API key
OPENROUTE_API_KEY=your_openroute_api_key_here

# 3. TomTom API Configuration (Traffic Data)
# Sign up at https://developer.tomtom.com/ to get your free API key
# Free tier: 2,500 requests/day + 50,000 tile requests/day
TOMTOM_API_KEY=your_tomtom_api_key_here

# 4. OpenWeather API Configuration (Weather Data)
# Sign up at https://openweathermap.org/api to get your free API key
OPENWEATHER_API_KEY=your_openweather_api_key_here
